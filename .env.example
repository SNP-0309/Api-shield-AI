NODE_ENV=production
PORT=5000

# Redis is required for shared telemetry and rate limits in production.
REDIS_URL=redis://redis:6379
ALLOW_IN_MEMORY_FALLBACK=false

# Use long, randomly generated values for all production credentials.
SENTINEL_API_KEYS=replace-with-a-long-random-api-key
# Optional legacy dashboard key. JWT login is recommended for dashboard access.
SENTINEL_ADMIN_API_KEY=replace-with-a-separate-dashboard-key

# Dashboard authentication. Use a MongoDB Atlas SRV connection string.
MONGODB_SRV=mongodb+srv://username:password@cluster.mongodb.net/api_shield
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# Set true only while creating the first dashboard admin account, then set false.
ALLOW_DASHBOARD_SIGNUP=true
AUTH_COOKIE_SAMESITE=lax

# Firebase dashboard authentication. Frontend values are public Firebase web config.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_EMAILS=admin@example.com
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Optional startup target. You can also set or change the target from
# Dashboard > Settings > Protected Application.
UPSTREAM_URL=https://api.example.com
UPSTREAM_TIMEOUT_MS=15000
REQUEST_BODY_LIMIT=1mb

# Comma-separated browser origins allowed to call the gateway.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=0
SECURITY_FAIL_OPEN=false
