NODE_ENV=production
PORT=5000

# Redis is required for shared telemetry and rate limits in production.
REDIS_URL=redis://redis:6379
ALLOW_IN_MEMORY_FALLBACK=false

# Use long, randomly generated values. The admin key is exposed to the
# dashboard browser, so scope it to dashboard read access in a real identity layer.
SENTINEL_API_KEYS=replace-with-a-long-random-api-key
SENTINEL_ADMIN_API_KEY=replace-with-a-separate-dashboard-key

# Requests sent to /proxy/* are forwarded to this service.
UPSTREAM_URL=https://api.example.com
UPSTREAM_TIMEOUT_MS=15000
REQUEST_BODY_LIMIT=1mb

# Comma-separated browser origins allowed to call the gateway.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0
SECURITY_FAIL_OPEN=false
