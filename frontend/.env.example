VITE_BACKEND_URL=http://localhost:5000
# Optional legacy dashboard API-key fallback. JWT login is used by default.
VITE_SENTINEL_API_KEY=replace-with-dashboard-key

# Firebase Web App configuration. These values are safe for browser use.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
